{
  "name": "jianyie",
  "private": true,
  "version": "0.19.0",
  "type": "module",
  "description": "笺页 · JianYIE —— 本地优先的 AI 角色聊天客户端",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test:smoke": "node scripts/run-smoke.mjs",
    "cap:sync": "vite build && cap sync android",
    "cap:open": "cap open android",
    "cap:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4",
    "@vicons/ionicons5": "^0.13.0",
    "dexie": "^4.4.0",
    "eventsource-parser": "^3.0.6",
    "fake-qq-ui": "^0.3.4",
    "parsecard": "^2.0.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.46",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.8",
    "typescript": "~5.9.0",
    "vite": "^7.3.8",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.166.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
